{
  "name": "sdcard-price-watch",
  "version": "1.0.0",
  "private": true,
  "description": "Track all-time-low prices and card offers on U3/V30 microSD cards (India) and report them by Gmail.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "check": "node src/index.js --check",
    "dry": "node src/index.js --dry-run --force",
    "test-email": "node src/index.js --test-email",
    "test": "node --test"
  },
  "dependencies": {
    "nodemailer": "^7.0.0"
  }
}
